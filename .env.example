# Copy to .env.local. Never commit real credentials.
MONGODB_URI=
MONGODB_DB=bazardor
# Atlas / replica set: true; standalone local MongoDB: false
MONGODB_TRANSACTIONS=true
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
